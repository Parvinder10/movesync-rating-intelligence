{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/:path*",
      "destination": "/public/static/:path*"
    },
    {
      "source": "/reports/:path*",
      "destination": "/public/reports/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}
